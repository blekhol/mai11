<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Új játék</title>
</head>
<body>
    <form method="post">
        <label for="nev">Játék neve</label>
        <input type="text" name="nev" required>
        <button type="submit">Felvétel</button>
    </form>
    <% if (locals.success) { %>
        <h3>Sikeres felvétel</h3>
        <p>id: <%= jatek.id %>, név: <%= jatek.nev %></p>
    <% } else { %>
        <h3>Sikertelen felvétel</h3>
    <% } %>
</body>
</html>